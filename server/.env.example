# Copy to .env.  NODE_ENV selects Development / Testing / Production behaviour.
NODE_ENV=production
PORT=3000
DATABASE_URL=postgres://fives:change-me@db:5432/fives
PGSSL=false
# REQUIRED in production: long random string  (openssl rand -hex 48)
JWT_SECRET=
JWT_TTL_HOURS=12
# true when served over HTTPS (cookies are then marked Secure). Behind a reverse proxy also set TRUST_PROXY=true
COOKIE_SECURE=true
TRUST_PROXY=true
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=12
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MIN=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Load the demo organisation on first start (empty database only). Turn off for real use.
SEED_DEMO=true
SEED_PASSWORD=Demo@123
# docker-compose
POSTGRES_PASSWORD=change-me
SITE_ADDRESS=:80
