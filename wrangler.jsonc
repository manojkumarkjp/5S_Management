{
  // Cloudflare Workers: static frontend + /api proxy to the AWS backend
  "name": "fives-5s",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "server/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "API_ORIGIN": "http://ec2-13-232-215-254.ap-south-1.compute.amazonaws.com"
  }
}
